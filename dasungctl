import argparse
import fcntl
import os
import select
import signal
import subprocess
import sys
import termios
import time
import tty
from pathlib import Path

DESCRIPTION = "Control the front light and display settings of Dasung Paperlike e-ink monitors."

DASUNG_TOUCH = "27c0"
CH340_UART = ("1a86", "7523")
CH341_SPI = ("1a86", "5512")

CONTRAST, MODE, REFRESH, SPEED = 0x01, 0x02, 0x03, 0x04
LIGHT, TEMPERATURE, BRIGHTNESS = 0x07, 0x08, 0x09
GET, VERSION = 0x0A, 0x10
ACK = 0xF0

LIGHT_MODES = {"off": 0, "cold": 1, "warm": 2, "mixed": 3}
LIGHT_NAMES = {v: k for k, v in LIGHT_MODES.items()}

PARAMS = {"contrast": CONTRAST, "mode": MODE, "speed": SPEED, "light": LIGHT,
          "temperature": TEMPERATURE, "brightness": BRIGHTNESS}
# The official clients clamp to these ranges before sending.
RANGES = {"contrast": range(1, 10), "mode": range(2, 8), "speed": range(1, 6),
          "temperature": range(0, 101)}

EX_TEMPFAIL = 75

STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "dasungctl"
RUNTIME = Path(os.environ["XDG_RUNTIME_DIR"]) / "dasungctl" if os.environ.get("XDG_RUNTIME_DIR") else None

LABELS = {"253": 'Dasung 25.3"', "13": 'Dasung 13.3"'}


class Busy(Exception):
    pass


class Error(Exception):
    pass


def usb_id(dev):
    try:
        return (dev / "idVendor").read_text().strip(), (dev / "idProduct").read_text().strip()
    except OSError:
        return None


def find_ports():
    found = []
    for tty_dir in sorted(Path("/sys/class/tty").glob("ttyUSB*")):
        try:
            uart = (tty_dir / "device").resolve().parents[1]
            siblings = {usb_id(dev) for dev in uart.parent.iterdir()}
        except (OSError, IndexError):
            continue
        # Dasungs keep a CH341 flash programmer next to their CH340; requiring both keeps
        # frames away from other serial adapters, such as the CH340 inside the BOOX Mira.
        if usb_id(uart) != CH340_UART or CH341_SPI not in siblings:
            continue
        # Of the tested models only the 13.3" adds a touch controller to that hub.
        name = "13" if any(i and i[0] == DASUNG_TOUCH for i in siblings) else "253"
        found.append((name, f"/dev/{tty_dir.name}"))
    return found


class Monitor:
    def __init__(self, path, debug=False, wait=3.0):
        self.debug = debug
        self.pending = ""
        self.fd = os.open(path, os.O_RDWR | os.O_NOCTTY)
        try:
            self._lock(wait)
            cc = termios.tcgetattr(self.fd)[6]
            cc[termios.VMIN] = 0
            cc[termios.VTIME] = 0
            cflag = termios.CS8 | termios.CREAD | termios.CLOCAL
            termios.tcsetattr(self.fd, termios.TCSANOW,
                              [0, 0, cflag, 0, termios.B115200, termios.B115200, cc])
            termios.tcflush(self.fd, termios.TCIOFLUSH)
        except BaseException:
            os.close(self.fd)
            raise

    def _lock(self, wait):
        # Key bindings start an instance per key press; their requests must not interleave.
        deadline = time.monotonic() + wait
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise Busy from None
                time.sleep(0.02)

    def close(self):
        # After an unplug both calls fail; neither may hide the error that is being reported.
        try:
            termios.tcdrain(self.fd)
        except termios.error:
            pass
        try:
            os.close(self.fd)
        except OSError:
            pass

    def send(self, cmd, value=0):
        frame = f"5FF5{cmd:02X}{value & 0xFF:02X}{0:012X}A0FA"
        if self.debug:
            print(f">> {frame}", file=sys.stderr)
        os.write(self.fd, frame.encode())

    def read(self):
        data = os.read(self.fd, 256)
        if not data:
            raise OSError("the monitor went away")
        if self.debug:
            # Raw rather than parsed, so frames of untested models show up too.
            print(f"<< {data.decode('ascii', 'replace')}", file=sys.stderr)
        self.pending += data.decode("ascii", "replace").upper()

    def parse(self):
        while True:
            i = self.pending.find("5FF5")
            if i < 0:
                # A frame prefix can be split across reads.
                self.pending = self.pending[-3:]
                return
            if len(self.pending) - i < 24:
                self.pending = self.pending[i:]
                return
            frame = self.pending[i:i + 24]
            try:
                payload = bytes.fromhex(frame[4:20])
            except ValueError:
                payload = None
            if payload is None or not frame.endswith("A0FA"):
                self.pending = self.pending[i + 1:]
                continue
            self.pending = self.pending[i + 24:]
            yield payload

    def frames(self, timeout=None):
        deadline = None if timeout is None else time.monotonic() + timeout
        while True:
            yield from self.parse()
            left = None if deadline is None else deadline - time.monotonic()
            if left is not None and left <= 0:
                return
            if not select.select([self.fd], [], [], left)[0]:
                return
            self.read()

    def query(self, param):
        # A frame that arrives while the monitor is still busy is dropped, so ask twice.
        for _ in range(2):
            self.send(GET, param)
            for payload in self.frames(0.4):
                # Button presses and status pushes can arrive in between, so match the reply.
                if payload[:3] == bytes([ACK, GET, param]):
                    return payload
        return None

    def set(self, cmd, value=0):
        others = []
        for _ in range(2):
            sent = time.monotonic()
            self.send(cmd, value)
            for payload in self.frames(0.4):
                if payload[:2] == bytes([ACK, cmd]):
                    break
                others.append(payload)
            else:
                continue
            if cmd == LIGHT:
                # The monitor then reports the new light state for about 200 ms and drops
                # whatever it receives meanwhile.
                others += self.frames(sent + 0.3 - time.monotonic())
            # Callers that track the state need the pushes that arrived meanwhile.
            return others
        raise Error("the monitor did not confirm the change")

    def get(self, param):
        payload = self.query(param)
        if payload is None:
            raise Error("the monitor did not answer")
        return payload[3]


def remember_mode(name, mode):
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        (STATE / f"light-{name}").write_text(f"{mode}\n")
    except OSError as e:
        print(f"dasungctl: cannot remember the light mode: {e.strerror}", file=sys.stderr)


def remembered_mode(name):
    try:
        mode = int((STATE / f"light-{name}").read_text())
    except (OSError, ValueError):
        mode = 0
    return mode if mode in LIGHT_NAMES and mode else LIGHT_MODES["warm"]


def level_arg(text):
    try:
        value = int(text)
    except ValueError:
        value = None
    if value is None or (text[0] not in "+-" and not 0 <= value <= 100):
        raise argparse.ArgumentTypeError("use 0-100, +N or -N")
    return text


def byte_arg(text):
    try:
        value = int(text, 16)
    except ValueError:
        value = -1
    if not 0 <= value <= 0xFF:
        raise argparse.ArgumentTypeError("use two hex digits, such as 0A")
    return value


def brightness(mon, name, text):
    mode = mon.get(LIGHT)
    current = mon.get(BRIGHTNESS) if mode else 0
    if text is None:
        print(current)
        return current
    value = int(text)
    target = max(0, min(100, current + value if text[0] in "+-" else value))
    if target == current:
        return current
    # Brightness 0 doubles as "off" so that one pair of keys covers the whole range.
    if target == 0:
        remember_mode(name, mode)
        mon.set(LIGHT, 0)
        return 0
    mon.set(BRIGHTNESS, target)
    if not mode:
        mon.set(LIGHT, remembered_mode(name))
    return target


def notify(title, body, slot, *, error=False):
    # notify-send only stacks notifications; replacing the previous one by its id keeps a
    # single notification per monitor that just changes its text.
    id_file = RUNTIME / f"notification-{slot}" if RUNTIME else None
    try:
        previous = int(id_file.read_text()) if id_file else 0
    except (OSError, ValueError):
        previous = 0
    cmd = ["notify-send", "--app-name=dasungctl", "--print-id",
           f"--expire-time={5000 if error else 2000}"]
    if not error:
        cmd.append("--transient")
    if previous:
        cmd.append(f"--replace-id={previous}")
    try:
        new = subprocess.run([*cmd, title, body], capture_output=True, text=True,
                             timeout=1).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return
    # The daemon hands out a new id once the old notification has expired.
    if id_file and new.isdigit() and int(new) != previous:
        try:
            id_file.parent.mkdir(parents=True, exist_ok=True)
            tmp = id_file.with_name(f"{id_file.name}.{os.getpid()}")
            tmp.write_text(new)
            os.replace(tmp, id_file)
        except OSError:
            pass


def tune(mon, name):
    if not sys.stdin.isatty():
        raise Error("tune needs a terminal")
    state = {p: mon.get(p) for p in (LIGHT, TEMPERATURE, BRIGHTNESS)}
    print(f'Dasung {name}": ←/→ brightness ±1   ↓/↑ temperature ±5   m light   q quit')
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)

    def draw():
        print(f"\r\x1b[Klight {LIGHT_NAMES.get(state[LIGHT], state[LIGHT]):6}"
              f"  brightness {state[BRIGHTNESS]:3}  temperature {state[TEMPERATURE]:3}",
              end="", flush=True)

    def suspend(signum, frame):
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        signal.signal(signal.SIGTSTP, signal.SIG_DFL)
        os.kill(os.getpid(), signal.SIGTSTP)
        signal.signal(signal.SIGTSTP, suspend)
        tty.setcbreak(fd)
        draw()

    # Without these the shell would inherit a terminal without echo.
    signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit(1))
    signal.signal(signal.SIGTSTP, suspend)
    keys = ""
    done = False
    try:
        tty.setcbreak(fd)
        while not done:
            draw()
            ready = select.select([fd, mon.fd], [], [])[0]
            if mon.fd in ready:
                mon.read()
                # Changes made with the monitor's buttons arrive here too.
                for payload in mon.parse():
                    if payload[0] in state:
                        state[payload[0]] = payload[1]
            if fd not in ready:
                continue
            keys += os.read(fd, 64).decode(errors="ignore")
            changed = set()
            while keys:
                if keys[0] == "\x1b":
                    if len(keys) < 3 and keys[1:] in ("", "[", "O"):
                        break  # the rest of an arrow key is still on its way
                    key, keys = (keys[:3], keys[3:]) if keys[1] in "[O" else ("", keys[1:])
                else:
                    key, keys = keys[0], keys[1:]
                if key == "q":
                    done = True
                    break
                if key[1:] in ("[C", "OC", "[D", "OD"):
                    param, delta = BRIGHTNESS, 1 if key[2] == "C" else -1
                elif key[1:] in ("[A", "OA", "[B", "OB"):
                    param, delta = TEMPERATURE, 5 if key[2] == "A" else -5
                elif key == "m":
                    param, delta = LIGHT, None
                else:
                    continue
                if delta is None:
                    state[LIGHT] = (state[LIGHT] + 1) % 4
                else:
                    state[param] = max(0, min(100, state[param] + delta))
                changed.add(param)
            # A held arrow key delivers several steps per read; the steps in between need not
            # reach the monitor.
            for param in sorted(changed):
                for payload in mon.set(param, state[param]):
                    if payload[0] in state:
                        state[payload[0]] = payload[1]
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        signal.signal(signal.SIGTSTP, signal.SIG_DFL)
        print()
        if state[LIGHT]:
            remember_mode(name, state[LIGHT])


def show_info(mon):
    payload = mon.query(VERSION)
    print(f"{'firmware':11} " + ("no reply" if payload is None else
                                 f"MCU {payload[3]:02x}.{payload[4]:02x}"))
    for name, param in PARAMS.items():
        payload = mon.query(param)
        value = "no reply" if payload is None else payload[3]
        if param == LIGHT and payload is not None:
            value = LIGHT_NAMES.get(value, value)
        print(f"{name:11} {value}")


def pick(found, monitor):
    candidates = [(n, p) for n, p in found if monitor in (None, n)]
    if monitor is None and len({n for n, _ in candidates}) > 1:
        candidates = [(n, p) for n, p in candidates if n == "253"]
    if not candidates:
        what = f'{monitor}" monitor' if monitor else "Dasung monitor"
        raise Error(f"no {what} found on USB (is the monitor's USB cable connected?)")
    if len(candidates) > 1:
        ports = ", ".join(p for _, p in candidates)
        raise Error(f"several matching monitors ({ports}), pick one with --port")
    return candidates[0]


def command(mon, args, name):
    if args.cmd == "info":
        show_info(mon)
    elif args.cmd == "tune":
        tune(mon, name)
    elif args.cmd == "brightness":
        level = brightness(mon, name, args.value)
        return f"Brightness {level} %" if level else "Front light off"
    elif args.cmd == "light":
        if args.value is None:
            print(LIGHT_NAMES.get(mon.get(LIGHT), "unknown"))
            return None
        mode = LIGHT_MODES[args.value]
        previous = mon.get(LIGHT) if mode == 0 else mode
        if previous:
            remember_mode(name, previous)
        mon.set(LIGHT, mode)
        return f"Front light {args.value}"
    elif args.cmd in RANGES:
        if args.value is None:
            print(mon.get(PARAMS[args.cmd]))
            return None
        mon.set(PARAMS[args.cmd], args.value)
        return f"{args.cmd.capitalize()} {args.value}"
    elif args.cmd == "refresh":
        mon.set(REFRESH)
    elif args.cmd == "raw":
        mon.send(args.command, args.value)
        for payload in mon.frames(args.wait):
            print(payload.hex(" "))
    elif args.cmd == "watch":
        for payload in mon.frames():
            print(time.strftime("%H:%M:%S"), payload.hex(" "), flush=True)
    return None


def run(args, name, port):
    relative = args.cmd == "brightness" and args.value is not None and args.value[0] in "+-"
    try:
        mon = Monitor(port, args.debug, wait=0 if relative else 3.0)
    except Busy:
        if relative:
            print(f"dasungctl: {port} is busy, step skipped", file=sys.stderr)
            sys.exit(EX_TEMPFAIL)
        raise Error(f"{port} is busy (is `dasungctl tune` or `watch` running?)") from None
    except PermissionError:
        raise Error(f"no access to {port}, install 70-dasung.rules (see README)") from None
    except OSError as e:
        raise Error(f"cannot open {port}: {e.strerror}") from None
    except termios.error:
        raise Error(f"{port} is not a serial port") from None
    try:
        text = command(mon, args, name)
        if text and args.notify:
            # Sent while the port is still locked, so the notifications of quick steps cannot
            # overtake each other and leave a stale value on screen.
            notify(LABELS.get(name, "Dasung"), text, name)
    except KeyboardInterrupt:
        pass
    except OSError as e:
        raise Error(f"lost the connection to {port}: {e.strerror or e}") from None
    finally:
        mon.close()


def main():
    ap = argparse.ArgumentParser(prog="dasungctl", description=DESCRIPTION)
    ap.add_argument("-m", "--monitor", choices=["253", "13"],
                    help='25.3" or 13.3" model (default: the only one connected, else 253)')
    ap.add_argument("--port", help="serial device instead of autodetection")
    ap.add_argument("--notify", action="store_true",
                    help="show changes and errors as a desktop notification, e.g. from key bindings")
    ap.add_argument("--debug", action="store_true", help="print raw frames")
    sub = ap.add_subparsers(dest="cmd", required=True, metavar="command")
    sub.add_parser("list", help="show detected monitors")
    sub.add_parser("info", help="show firmware version and settings")
    sub.add_parser("tune", help="adjust the front light with the arrow keys")
    sub.add_parser("brightness", help="front light brightness; 0 switches the light off").add_argument(
        "value", nargs="?", type=level_arg,
        help="0-100, or +N/-N relative; a relative step is skipped while another dasungctl "
             "talks to the monitor, so held keys never queue up")
    sub.add_parser("light", help="front light colour").add_argument(
        "value", nargs="?", choices=list(LIGHT_MODES))
    sub.add_parser("temperature", help="colour temperature of mixed light").add_argument(
        "value", type=int, nargs="?", help="0 warm to 100 cold")
    sub.add_parser("contrast", help="contrast").add_argument(
        "value", type=int, nargs="?", help="1-9")
    sub.add_parser("mode", help="image mode").add_argument(
        "value", type=int, nargs="?", help="2-7, the meaning differs by model")
    sub.add_parser("speed", help="refresh speed").add_argument(
        "value", type=int, nargs="?", help="1-5")
    sub.add_parser("refresh", help="clear ghosting")
    raw = sub.add_parser("raw", help="send any command and print the replies (protocol research)")
    raw.add_argument("command", type=byte_arg, help="hex, such as 0A")
    raw.add_argument("value", type=byte_arg, nargs="?", default=0, help="hex, default 00")
    raw.add_argument("--wait", type=float, default=1.0, help="seconds to wait for replies")
    sub.add_parser("watch", help="print the frames the monitor sends")
    args = ap.parse_args()

    name = args.monitor or "dasung"
    try:
        found = find_ports()
        if args.cmd == "list":
            if not found:
                raise Error("no Dasung monitor found on USB")
            for monitor, port in found:
                print(f'{monitor}"  {port}')
            return
        if args.port:
            port = args.port
            real = os.path.realpath(port)
            name = args.monitor or next((n for n, p in found if p == real), "custom")
        else:
            name, port = pick(found, args.monitor)
        if args.cmd in RANGES and args.value is not None and args.value not in RANGES[args.cmd]:
            r = RANGES[args.cmd]
            raise Error(f"{args.cmd} must be {r.start}-{r.stop - 1}")
        run(args, name, port)
    except Error as e:
        # Like any CLI on stderr; from a key binding only the notification is ever seen.
        print(f"dasungctl: {e}", file=sys.stderr)
        if args.notify:
            notify(f"{LABELS.get(name, 'Dasung')} error", str(e), name, error=True)
        sys.exit(1)


if __name__ == "__main__":
    main()
